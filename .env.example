# Copy to .env (git-ignored). Used by docker-compose.yml.
TZ=America/Los_Angeles

# Optional dashboard password (second layer behind Cloudflare Access / Tailscale).
SOLARDASH_PASSWORD=

# Weather Underground PWS key (or put it in config.yaml under weather.api_key).
SOLARDASH_WU_API_KEY=

# Cloudflare Tunnel token from Zero Trust -> Networks -> Tunnels -> your tunnel.
TUNNEL_TOKEN=
